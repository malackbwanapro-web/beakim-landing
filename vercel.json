{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/blog/:match*",
      "destination": "/insights/:match*",
      "permanent": true
    },
    {
      "source": "/crm",
      "destination": "https://crm.beakimhospitalitygroup.co.ke",
      "permanent": true
    },
    {
      "source": "/crm/:match*",
      "destination": "https://crm.beakimhospitalitygroup.co.ke/:match*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/tower-cottages",
      "destination": "/tower-cottages.html"
    },
    {
      "source": "/diani-darling",
      "destination": "/diani-darling.html"
    },
    {
      "source": "/beakim-darad",
      "destination": "/beakim-darad.html"
    },
    {
      "source": "/beakim-apartments",
      "destination": "/beakim-apartments.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service.html"
    },
    {
      "source": "/insights",
      "destination": "/insights.html"
    },
    {
      "source": "/seo-matrix",
      "destination": "/seo-matrix.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    }
  ]
}
